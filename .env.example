# Decision backend: typesafe (hosted Jev, default) or openai (any OpenAI-compatible endpoint, e.g. local Ollama).
JEV_BACKEND=typesafe
ACTION_MODEL_BASE_URL=http://127.0.0.1:11434/v1
ACTION_MODEL=m3ta/qwen3-abl-8b-nothink-32k
# Optional; Ollama ignores it.
ACTION_MODEL_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Danger-zone opt-ins (docs.typesafe.ai/images). Images + Box questions; Box needs jev-1.14.0.
TYPESAFE_DANGER_ZONE_IMAGES=true
TYPESAFE_DANGER_ZONE_LONG_CONTEXT=false
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
